<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:alpha="0.7"
            android:text="4 dias de trabalho, 6 de folga — repete a cada 10 dias"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/avisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Switch
            android:id="@+id/swAtivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="Alarme ligado"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Titulo"
            android:text="1º dia de trabalho de um ciclo" />

        <TextView
            android:id="@+id/txtInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolher data" />

        <TextView
            android:id="@+id/txtHoje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:textStyle="italic" />

        <TextView
            style="@style/Titulo"
            android:text="Horário de cada dia de trabalho" />

        <LinearLayout
            android:id="@+id/dias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/Titulo"
            android:text="Som" />

        <Button
            android:id="@+id/btnSom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical" />

        <TextView
            style="@style/Titulo"
            android:text="Próximos alarmes" />

        <TextView
            android:id="@+id/txtProximos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnTestar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Testar alarme (toca em 10 segundos)" />
    </LinearLayout>
</ScrollView>
